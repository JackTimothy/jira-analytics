# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
# Anything already exported in your shell wins over this file, so you can
# override a single value for one run:
#   JIRA_API_TOKEN=other-token go run ./cmd/server

JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com

# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# A token with read access to the repositories in projects.yaml
GITHUB_TOKEN=

# Optional
# GITHUB_BASE_URL=https://github.example.com/api/v3   # GitHub Enterprise
# PORT=8080
# PROJECTS_FILE=projects.yaml
# WEB_DIR=web/dist
